NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# GotIt currently uses the same physical PostgreSQL instance as rbase Core.
# The URL must point to the database that already contains product_gotit.*.
DATABASE_URL=postgres://rbase:rbase@postgres:5432/rbase

CORE_API_BASE_URL=https://rbase-core-api.onrender.com
CORE_APPLICATION_KEY=gotit
CORE_AUTH_TIMEOUT_MS=3000

# Exact client origins, separated by commas. Empty securely disables browser CORS;
# configure exact origins before claiming Web/extension readiness.
# The backend's own Render URL is not a substitute for the Web/extension origins.
CORS_ORIGINS=http://localhost:5173
# Set only to the verified reverse-proxy hop count for the hosting topology.
TRUST_PROXY_HOPS=0
# Optional validated server-side learning/reward policy overrides.
# LEARNING_POLICY_JSON=

# Anthropic remains dedicated to reading/story generation.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=wrkspc_example
# AI_READING_MODEL=claude-sonnet-5
CLAUDE_STRUCTURED_OUTPUT=false

# OpenAI handles contextual AI translation through the Responses API.
# OPENAI_API_KEY=
# OPENAI_TRANSLATION_MODEL=gpt-5.4-nano
# ENRICHMENT_SIGNING_SECRET=at-least-32-random-bytes
# Advanced server-only model profiles/routes; credentials stay separate.
# ENRICHMENT_PROFILES_JSON=

# Google Cloud Translation Basic v2: opt in only after confirming the enabled API.
# GOOGLE_TRANSLATION_API=cloud_basic_v2
# GOOGLE_TRANSLATE_API_KEY=
# Optional explicit BCP-47 to provider-language mappings.
# GOOGLE_TRANSLATION_LANGUAGES_JSON={"zh-Hans":"zh-CN","zh-Hant":"zh-TW"}

# Google Text-to-Speech can reuse GOOGLE_TRANSLATE_API_KEY. Speech-to-Text uses
# ADC: either service-account JSON or a path to a server-side credential file.
# SPEECH_PROVIDER=google
# GOOGLE_SPEECH_API_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-service-account.json
# GOOGLE_SPEECH_LANGUAGES_JSON={"en":{"locale":"en-US","voice":"en-US-Standard-C","recognitionLocale":"en-US","recognitionModel":"latest_short"},"he":{"locale":"he-IL","voice":"he-IL-Standard-A","recognitionLocale":"iw-IL","recognitionModel":"command_and_search"}}

# Azure remains available as an alternative with native pronunciation assessment.
# AZURE_SPEECH_API_KEY=
# AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_LANGUAGES_JSON={"en":{"locale":"en-US","voice":"en-US-JennyNeural"}}

# Explicit migration administrator connection. Never use runtime credentials.
# Export this variable before npm run migrate:up; migration tooling does not load .env.
# GOTIT_MIGRATION_DATABASE_URL=

# Read-only inspection of a remote database. Use the external URL locally and add
# sslmode=require. This never becomes the runtime or migration connection.
# GOTIT_INSPECTION_DATABASE_URL=
